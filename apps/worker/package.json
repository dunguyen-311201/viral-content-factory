{
  "name": "@vcf/worker",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ background worker for AI and media jobs.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:integration": "jest -c jest.integration.config.js --runInBand"
  },
  "dependencies": {
    "@prisma/client": "~6.19.0",
    "@vcf/ai": "workspace:*",
    "@vcf/shared": "workspace:*",
    "bullmq": "^5.60.0",
    "ioredis": "^5.8.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  }
}
