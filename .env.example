# Copy to .env for local development:
#   macOS/Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
# Placeholders only. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=info
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Ports / URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WORKER_HEALTH_PORT=4001

# Infrastructure (matches docker-compose.yml defaults; local development only)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vcf
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vcf
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=vcf

# Auth: not implemented in Sprint 0. Required (>= 32 random chars) when NODE_ENV=production.
AUTH_SECRET=replace_me

# AI / media providers: only "mock" is accepted until the Project Owner approves a real provider.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_VOICE=

# Media storage
MEDIA_STORAGE_DRIVER=local
MEDIA_STORAGE_PATH=./storage/media

# Budget guardrail (planning constraint, VND per month)
MONTHLY_BUDGET_VND=3000000
