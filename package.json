{
  "name": "viral-content-factory",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted editorial and production workspace for one operator (modular monolith).",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "postinstall": "pnpm run db:generate && pnpm run build:packages",
    "build:packages": "pnpm --filter @vcf/shared --filter @vcf/ai run build",
    "build": "pnpm run build:packages && pnpm --filter @vcf/api --filter @vcf/worker --filter @vcf/web run build",
    "dev:api": "pnpm --filter @vcf/api run dev",
    "dev:worker": "pnpm --filter @vcf/worker run dev",
    "dev:web": "pnpm --filter @vcf/web run dev",
    "lint": "eslint .",
    "typecheck": "pnpm run build:packages && pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "pnpm -r --workspace-concurrency=1 run test:integration",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@prisma/client": "~6.19.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "eslint": "^9.39.0",
    "jest": "^29.7.0",
    "prisma": "~6.19.0",
    "ts-jest": "^29.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "packageManager": "pnpm@10.28.0"
}
